# Template for local configuration.
# Copy it to .env and fill in real values:   cp .env.example .env
# This file IS committed, so it must never contain real secrets.

# --- PostgreSQL (runs in Docker) ---
POSTGRES_USER=contextos
POSTGRES_PASSWORD=change-me
POSTGRES_DB=contextos
# Host port. Not the default 5432, so we never clash with other local Postgres instances.
POSTGRES_PORT=5433

# --- Redis (runs in Docker) ---
# Host port. Not the default 6379, for the same reason.
REDIS_PORT=6380

# --- Uploads (optional; uncomment to override the defaults) ---
# Folder for uploaded files. Default: <repo>/data/uploads
# UPLOAD_DIR=/absolute/path/to/uploads
# Maximum upload size in bytes. Default: 26214400 (25 MiB)
# MAX_UPLOAD_BYTES=26214400

# --- Background jobs and logging (optional; uncomment to override) ---
# Redis queue name. Default: contextos
# QUEUE_NAME=contextos
# Log level: DEBUG, INFO or WARNING. Default: INFO
# LOG_LEVEL=INFO

# --- LLM for answers (Google Gemini) ---
# Create a free key at https://aistudio.google.com/apikey and paste it here (in .env only).
# Without it the API still runs; only POST /ask returns 503.
GEMINI_API_KEY=
# Model id. Default: gemini-3.5-flash-lite (stable, most generous free daily quota)
# LLM_MODEL=gemini-3.5-flash-lite

# --- Connectors (optional) ---
# GitHub token: public repos sync without one (60 requests/hour); with one, 5,000/hour,
# and it is needed to open issues from approved actions. Fine-grained token, repo scope.
GITHUB_TOKEN=
# Folder connector root: only folders inside it can be synced. Default: <repo>/data/sources
# FOLDER_ROOT=/absolute/path
